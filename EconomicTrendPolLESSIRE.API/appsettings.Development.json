//appsettings.Development.json
{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "EconomicTrendsPolLESSIRE.Infrastructure.Services.MistralOrchestrator": "Information",
      "EconomicTrendsPolLESSIRE.Infrastructure.Services.MistralAIService": "Information"
    }
  },
  "ConnectionStrings": {
    "default": "Data Source=(localdb)\\MSSQLLocalDB;Initial Catalog=EconomicTrendsPolLESSIREDb;Integrated Security=True;Connect Timeout=60;Encrypt=True;TrustServerCertificate=True;Column Encryption Setting=Enabled;MultipleActiveResultSets=False;"
  },
  "MistralAI": {
    "ApiBaseUrl": "http://127.0.0.1:11435/",
    "Model": "economictrends-mistral",
    "Temperature": 0.3,
    "GenerationTimeoutSeconds": 900,
    "NumPredict": 320,
    "NumContext": 4096
  },
  "Security": {
    "Enabled": false
  },
  "EconomicTrendsPolLESSIRE": {
    "RequireEventId": false,
    "AllowHeaderFallback": false
  },
  "Ollama": {
    "BaseUrl": "http://127.0.0.1:11435/"
  },
  "MongoDb": {
    "ConnectionString": "mongodb://localhost:27017",
    "DatabaseName": "EconomicTrendsPolLESSIRE_Dev"
  },
  "FastApiAI": {
    "BaseUrl": "http://127.0.0.1:8010/",
    "GenerationEndpoint": "api/v1/generate",
    "StreamingEndpoint": "api/v1/generate/stream",
    "TimeoutSeconds": 900,
    "DefaultTemperature": 0.3
  }
}
